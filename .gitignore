# Build output: `dist/` holds the compiled bundles, `outputs/` holds every shippable artifact.
# No other directory may contain either (see docs/adr/0007-single-release-directory.md).
dist/
outputs/*
!outputs/.gitkeep
work/

# Upstream reference checkouts kept locally for cross-checking protocol behaviour.
v2rayN-*/

.DS_Store
Thumbs.db

# Ad-hoc debug copies of smoke scripts (e.g. .send-probe.tmp.cjs) must never linger in
# the repository root; they resolve their own __dirname-relative roots and break in CI.
.*.tmp.cjs
