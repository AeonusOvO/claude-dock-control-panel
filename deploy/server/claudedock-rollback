#!/usr/bin/env bash
set -euo pipefail

version=$1
if [[ ! "$version" =~ ^(bootstrap|(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*))$ ]]; then
  echo "Invalid rollback version." >&2
  exit 64
fi

release=/srv/claudedock/releases/"$version"
if [[ ! -d "$release" ]]; then
  echo "Verified rollback release does not exist." >&2
  exit 65
fi

if [[ "$version" != bootstrap ]]; then
  /usr/bin/node /usr/local/lib/claudedock/verify-release-bundle.mjs \
    "$release" \
    --public-key /etc/claudedock/release-manifest-public-key.pem \
    --expected-version "$version"
fi

temporary_link=/srv/claudedock/".rollback-$$"
/usr/bin/ln -s "releases/$version" "$temporary_link"
/usr/bin/mv -T -- "$temporary_link" /srv/claudedock/current
