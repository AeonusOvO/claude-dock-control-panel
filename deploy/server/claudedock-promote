#!/usr/bin/env bash
set -euo pipefail

version=$1
run_id=$2
if [[ ! "$version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
  echo "Invalid stable version." >&2
  exit 64
fi
if [[ ! "$run_id" =~ ^[0-9]{1,20}$ ]]; then
  echo "Invalid GitHub Actions run id." >&2
  exit 64
fi

incoming=/srv/claudedock/incoming/"$version-$run_id"
release=/srv/claudedock/releases/"$version"
staging=/srv/claudedock/".promoting-$version-$run_id"
if [[ ! -d "$incoming" || -e "$release" ]]; then
  echo "Incoming release is missing or immutable release already exists." >&2
  exit 65
fi
deploy_owner=$(/usr/bin/stat -c %U /srv/claudedock/incoming)
if [[ -z "$deploy_owner" || "$deploy_owner" == root || $(/usr/bin/stat -c %U "$incoming") != "$deploy_owner" ]]; then
  echo "Incoming release owner is invalid." >&2
  exit 65
fi

if [[ -e "$staging" ]]; then
  echo "A protected promotion directory already exists." >&2
  exit 65
fi

# Move the upload out of the deploy user's writable parent before validation. This closes the race
# between digest verification and publication and prevents a compromised deploy key from swapping
# files after they have been checked.
/usr/bin/mv -- "$incoming" "$staging"
trap '/usr/bin/rm -rf -- "$staging"' EXIT
/usr/bin/chown -R root:root "$staging"
/usr/bin/chmod -R u=rwX,go=rX "$staging"

installer="ClaudeDock-Setup-$version-x64.exe"
expected_files=(
  "$installer"
  "$installer.blockmap"
  latest.yml
  release-manifest.json
  release-manifest.sig
)
mapfile -d '' uploaded_entries < <(/usr/bin/find "$staging" -mindepth 1 -maxdepth 1 -print0)
if [[ ${#uploaded_entries[@]} -ne ${#expected_files[@]} ]]; then
  echo "Incoming release must contain exactly five public files." >&2
  exit 65
fi
for name in "${expected_files[@]}"; do
  file="$staging/$name"
  if [[ ! -f "$file" || -L "$file" || $(/usr/bin/stat -c %U "$file") != root || $(/usr/bin/stat -c %h "$file") -ne 1 ]]; then
    echo "Incoming release contains an invalid file: $name" >&2
    exit 65
  fi
done

/usr/bin/node /usr/local/lib/claudedock/verify-release-bundle.mjs \
  "$staging" \
  --public-key /etc/claudedock/release-manifest-public-key.pem \
  --expected-version "$version"

/usr/bin/mv -- "$staging" "$release"
trap - EXIT

temporary_link=/srv/claudedock/".current-$run_id"
/usr/bin/ln -s "releases/$version" "$temporary_link"
/usr/bin/mv -T -- "$temporary_link" /srv/claudedock/current
