{
  "name": "claude-dock-control-panel",
  "version": "5.0.0-rc.38",
  "description": "Windows 项目终端与 Claude Code / Codex 可视化工作台。",
  "license": "Apache-2.0",
  "main": "dist/main/index.js",
  "private": true,
  "author": {
    "name": "AeonusOvO",
    "url": "https://github.com/AeonusOvO"
  },
  "homepage": "https://github.com/AeonusOvO/claude-dock-control-panel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AeonusOvO/claude-dock-control-panel.git"
  },
  "bugs": {
    "url": "https://github.com/AeonusOvO/claude-dock-control-panel/issues"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "clean": "node scripts/build/clean.mjs",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "dev": "npm run clean && npm run generate:icons && concurrently -k \"npm:dev:main\" \"npm:dev:preload\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:preload": "vite build --config vite.preload.config.ts --watch",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:5173 dist/main/index.js dist/preload/preload.js && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "generate:icons": "node scripts/build/generate-icons.mjs",
    "generate:source-identity": "node scripts/build/source-identity.mjs",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.{mjs,cjs}\" vite.config.ts vite.preload.config.ts --max-warnings=0",
    "lint:deps": "depcruise src tests --config .dependency-cruiser.cjs --output-type err",
    "lint:deps:graph": "depcruise src --config .dependency-cruiser.cjs --output-type archi",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "test": "vitest run --maxWorkers=4",
    "test:conpty": "npm run build && npm run test:conpty:built",
    "test:conpty:built": "electron scripts/smoke/conpty-resize-smoke.cjs",
    "test:control-theme": "npm run build:renderer && electron scripts/smoke/control-theme-smoke.cjs",
    "test:dialog-select": "npm run build:renderer && electron scripts/smoke/dialog-select-smoke.cjs",
    "test:layout": "npm run build:renderer && electron scripts/smoke/layout-smoke.cjs",
    "test:network": "npm run build:main && electron scripts/smoke/network-request-smoke.cjs",
    "test:model-usage": "npm run build:main && npm run build:preload && npm run build:renderer && electron scripts/smoke/model-usage-smoke.cjs",
    "test:runtime-soak": "node scripts/smoke/runtime-soak.cjs",
    "test:runtime-soak:accelerated": "node scripts/smoke/runtime-soak.cjs --hours=24 --accelerated",
    "test:scroll-chaining": "npm run build:preload && npm run build:renderer && electron scripts/smoke/scroll-chaining-smoke.cjs",
    "test:select": "npm run build:renderer && electron scripts/smoke/select-interaction-smoke.cjs",
    "test:select-theme": "npm run build:renderer && electron scripts/smoke/select-theme-smoke.cjs",
    "test:visual": "npm run build:renderer && electron scripts/smoke/visual-smoke.cjs && electron scripts/smoke/native-visual-smoke.cjs",
    "test:visual:native": "npm run build:renderer && electron scripts/smoke/native-visual-smoke.cjs",
    "test:visual:real": "npm run build && node scripts/smoke/real-electron-visual-qa.cjs",
    "test:coverage": "vitest run --coverage",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run generate:source-identity && npm run generate:icons && npm run typecheck && npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis",
    "release:clean": "node scripts/release/clean-outputs.mjs",
    "release:manifest": "node scripts/release/manifest.mjs",
    "release:publish:cos": "node scripts/release/publish-cos.mjs",
    "release": "node scripts/release/release.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.224",
    "@anthropic-ai/sdk": "^0.115.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@lydell/node-pty": "1.2.0-beta.14",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@shikijs/engine-oniguruma": "^4.3.1",
    "@shikijs/langs": "^4.3.1",
    "@shikijs/themes": "^4.3.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "d3": "^7.9.0",
    "electron-updater": "^6.8.9",
    "katex": "^0.18.1",
    "marked": "^18.0.7",
    "mermaid": "^11.16.1",
    "plotly.js-dist-min": "^3.7.0",
    "shiki": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "10.0.1",
    "@noble/hashes": "2.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "7zip-bin": "5.2.0",
    "concurrently": "10.0.4",
    "cos-nodejs-sdk-v5": "3.0.0",
    "cross-env": "10.1.0",
    "dependency-cruiser": "^18.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "10.8.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.0",
    "png-to-ico": "3.0.2",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wait-on": "9.1.0",
    "yaml": "2.9.0"
  },
  "build": {
    "appId": "io.github.aeonusovo.claudedock",
    "copyright": "Copyright © 2026 AeonusOvO",
    "productName": "ClaudeDock 控制面板",
    "artifactName": "ClaudeDock-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "outputs"
    },
    "detectUpdateChannel": true,
    "publish": {
      "provider": "generic",
      "url": "https://claudedock-1304375868.cos.ap-shanghai.myqcloud.com/updates/windows/x64/",
      "useMultipleRangeRequest": false
    },
    "files": [
      "dist/**/*",
      "assets/generated/**/*",
      "assets/runtime/**/*",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**/*",
      "LICENSE",
      "NOTICE",
      "package.json"
    ],
    "asarUnpack": [
      "assets/runtime/**/*",
      "node_modules/@lydell/node-pty/**/*",
      "node_modules/@lydell/node-pty-*/**/*"
    ],
    "win": {
      "icon": "assets/generated/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClaudeDock 控制面板"
    }
  }
}
